{
  "datasets": [
    {
      "name": "gold_sales",
      "displayName": "Gold Sales Summary",
      "queryLines": [
        "SELECT\n",
        "  *\n",
        "FROM\n",
        "  genie_demo_dev.de_demo.gold_sales_summary"
      ]
    }
  ],
  "pages": [
